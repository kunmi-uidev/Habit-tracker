rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHabit(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.icon is string && data.icon.size() <= 100 &&
             data.completedDays is list && data.completedDays.size() == 7 &&
             data.isCompletedToday is bool &&
             data.streak is number &&
             data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);

      match /habits/{habitId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(habitId);
        
        allow create: if isOwner(userId) && isValidId(habitId) && 
          isValidHabit(request.resource.data) &&
          request.resource.data.updatedAt == request.time;

        allow update: if isOwner(userId) && isValidId(habitId) &&
          isValidHabit(request.resource.data) &&
          request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      match /notifications/{notificationId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId) && isValidId(notificationId);
        
        allow create: if isOwner(userId) && isValidId(notificationId) &&
          request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
          request.resource.data.body is string && request.resource.data.body.size() <= 1000 &&
          request.resource.data.type in ['reminder', 'motivation', 'congratulations', 'streak'] &&
          request.resource.data.isRead is bool &&
          request.resource.data.userId == userId;

        allow update: if isOwner(userId) && isValidId(notificationId) &&
          request.resource.data.title is string && request.resource.data.title.size() <= 150 &&
          request.resource.data.body is string && request.resource.data.body.size() <= 1000 &&
          request.resource.data.type in ['reminder', 'motivation', 'congratulations', 'streak'] &&
          request.resource.data.isRead is bool &&
          request.resource.data.userId == userId;

        allow delete: if isOwner(userId) && isValidId(notificationId);
      }
    }
  }
}
